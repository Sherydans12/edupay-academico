# Operational backup transfer inventory only. Keep live values in managed
# runtime secret storage; never commit endpoint, bucket, or credential values.
# This file is not consumed by application containers.

BACKUP_REQUIRE_OFFHOST=1
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_ENDPOINT=
BACKUP_R2_BUCKET=
BACKUP_R2_PREFIX=edupay-academico/pilot
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=

# BACKUP_R2_ENDPOINT is the HTTPS S3-compatible Cloudflare R2 endpoint for
# the approved account. BACKUP_R2_ACCESS_KEY_ID and
# BACKUP_R2_SECRET_ACCESS_KEY are runtime secrets and must not be echoed.
