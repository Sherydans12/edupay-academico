# Normalize text files for consistent cross-platform diffs and deployment.
* text=auto eol=lf

# Keep common binary assets out of text normalization.
*.7z binary
*.avi binary
*.bmp binary
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.mov binary
*.mp3 binary
*.mp4 binary
*.pdf binary
*.png binary
*.tar binary
*.ttf binary
*.wav binary
*.webp binary
*.woff binary
*.woff2 binary
*.xls binary
*.xlsx binary
*.zip binary
