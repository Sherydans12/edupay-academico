generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AcademicYearStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum CourseStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PersonStatus {
  ACTIVE
  INACTIVE
}

enum SubjectStatus {
  ACTIVE
  ARCHIVED
}

enum CourseSubjectStatus {
  ACTIVE
  ARCHIVED
}

enum RelationshipStatus {
  ACTIVE
  INACTIVE
}

enum LearningUnitStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum LearningItemType {
  MATERIAL
  ASSIGNMENT
  ASSESSMENT
  ANNOUNCEMENT
}

enum LearningItemPublicationStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model Tenant {
  id        String   @id @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicYears             AcademicYear[]
  courses                   Course[]
  students                  Student[]
  teachers                  Teacher[]
  subjects                  Subject[]
  courseSubjects            CourseSubject[]
  courseEnrollments         CourseEnrollment[]
  studentSubjectEnrollments StudentSubjectEnrollment[]
  courseSubjectTeachers     CourseSubjectTeacher[]
  learningUnits             LearningUnit[]
  learningItems             LearningItem[]

  @@map("tenants")
}

model AcademicYear {
  id              String             @default(uuid()) @db.Uuid
  tenantId        String             @map("tenant_id") @db.VarChar(128)
  paginationToken String             @unique @default(uuid()) @map("pagination_token") @db.Uuid
  label           String             @db.VarChar(160)
  startDate       DateTime           @map("start_date") @db.Date
  endDate         DateTime           @map("end_date") @db.Date
  status          AcademicYearStatus @default(DRAFT)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  courses Course[]

  @@id([tenantId, id])
  @@unique([tenantId, label])
  @@index([tenantId, status, startDate])
  @@map("academic_years")
}

model Course {
  id              String       @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.VarChar(128)
  academicYearId  String       @map("academic_year_id") @db.Uuid
  paginationToken String       @unique @default(uuid()) @map("pagination_token") @db.Uuid
  label           String       @db.VarChar(160)
  status          CourseStatus @default(DRAFT)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear       @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict)
  courseSubjects CourseSubject[]
  enrollments    CourseEnrollment[]

  @@id([tenantId, id])
  @@unique([tenantId, academicYearId, label])
  @@index([tenantId, academicYearId, status, label])
  @@map("courses")
}

model Student {
  id                String       @default(uuid()) @db.Uuid
  tenantId          String       @map("tenant_id") @db.VarChar(128)
  paginationToken   String       @unique @default(uuid()) @map("pagination_token") @db.Uuid
  identityUserId    String?      @map("identity_user_id") @db.VarChar(128)
  source            String       @default("MANUAL") @db.VarChar(80)
  externalReference String?      @map("external_reference") @db.VarChar(200)
  firstName         String       @map("first_name") @db.VarChar(120)
  lastName          String       @map("last_name") @db.VarChar(120)
  email             String?      @db.VarChar(320)
  status            PersonStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  courseEnrollments  CourseEnrollment[]
  subjectEnrollments StudentSubjectEnrollment[]

  @@id([tenantId, id])
  @@unique([tenantId, identityUserId])
  @@unique([tenantId, source, externalReference])
  @@index([tenantId, status, lastName, firstName])
  @@map("students")
}

model Teacher {
  id                String       @default(uuid()) @db.Uuid
  tenantId          String       @map("tenant_id") @db.VarChar(128)
  paginationToken   String       @unique @default(uuid()) @map("pagination_token") @db.Uuid
  identityUserId    String?      @map("identity_user_id") @db.VarChar(128)
  source            String       @default("MANUAL") @db.VarChar(80)
  externalReference String?      @map("external_reference") @db.VarChar(200)
  firstName         String       @map("first_name") @db.VarChar(120)
  lastName          String       @map("last_name") @db.VarChar(120)
  email             String?      @db.VarChar(320)
  status            PersonStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assignments CourseSubjectTeacher[]

  @@id([tenantId, id])
  @@unique([tenantId, identityUserId])
  @@unique([tenantId, source, externalReference])
  @@index([tenantId, status, lastName, firstName])
  @@map("teachers")
}

model Subject {
  id              String        @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.VarChar(128)
  paginationToken String        @unique @default(uuid()) @map("pagination_token") @db.Uuid
  name            String        @db.VarChar(160)
  status          SubjectStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  courseSubjects CourseSubject[]

  @@id([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId, status, name])
  @@map("subjects")
}

model CourseSubject {
  id               String              @default(uuid()) @db.Uuid
  tenantId         String              @map("tenant_id") @db.VarChar(128)
  courseId         String              @map("course_id") @db.Uuid
  subjectId        String              @map("subject_id") @db.Uuid
  paginationToken  String              @unique @default(uuid()) @map("pagination_token") @db.Uuid
  defaultForCourse Boolean             @default(true) @map("default_for_course")
  sortOrder        Int                 @default(0) @map("sort_order")
  status           CourseSubjectStatus @default(ACTIVE)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  course             Course                     @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Restrict)
  subject            Subject                    @relation(fields: [tenantId, subjectId], references: [tenantId, id], onDelete: Restrict)
  directEnrollments  StudentSubjectEnrollment[]
  teacherAssignments CourseSubjectTeacher[]
  learningUnits      LearningUnit[]
  learningItems      LearningItem[]

  @@id([tenantId, id])
  @@index([tenantId, courseId, status, sortOrder])
  @@index([tenantId, subjectId, status])
  @@map("course_subjects")
}

model CourseEnrollment {
  id        String             @default(uuid()) @db.Uuid
  tenantId  String             @map("tenant_id") @db.VarChar(128)
  studentId String             @map("student_id") @db.Uuid
  courseId  String             @map("course_id") @db.Uuid
  status    RelationshipStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)
  course  Course  @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, id])
  @@index([tenantId, courseId, status, studentId])
  @@index([tenantId, studentId, status, courseId])
  @@map("course_enrollments")
}

model StudentSubjectEnrollment {
  id              String             @default(uuid()) @db.Uuid
  tenantId        String             @map("tenant_id") @db.VarChar(128)
  studentId       String             @map("student_id") @db.Uuid
  courseSubjectId String             @map("course_subject_id") @db.Uuid
  status          RelationshipStatus @default(ACTIVE)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  student       Student       @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)
  courseSubject CourseSubject @relation(fields: [tenantId, courseSubjectId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, id])
  @@index([tenantId, studentId, status, courseSubjectId])
  @@index([tenantId, courseSubjectId, status, studentId])
  @@map("student_subject_enrollments")
}

model CourseSubjectTeacher {
  id              String             @default(uuid()) @db.Uuid
  tenantId        String             @map("tenant_id") @db.VarChar(128)
  teacherId       String             @map("teacher_id") @db.Uuid
  courseSubjectId String             @map("course_subject_id") @db.Uuid
  status          RelationshipStatus @default(ACTIVE)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  teacher       Teacher       @relation(fields: [tenantId, teacherId], references: [tenantId, id], onDelete: Restrict)
  courseSubject CourseSubject @relation(fields: [tenantId, courseSubjectId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, id])
  @@index([tenantId, teacherId, status, courseSubjectId])
  @@index([tenantId, courseSubjectId, status, teacherId])
  @@map("course_subject_teachers")
}

model LearningUnit {
  id              String            @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.VarChar(128)
  courseSubjectId String            @map("course_subject_id") @db.Uuid
  title           String            @db.VarChar(160)
  description     String?           @db.Text
  sortOrder       Int               @default(0) @map("sort_order")
  startAt         DateTime?         @map("start_at") @db.Timestamptz(3)
  endAt           DateTime?         @map("end_at") @db.Timestamptz(3)
  status          LearningUnitStatus @default(DRAFT)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  courseSubject CourseSubject @relation(fields: [tenantId, courseSubjectId], references: [tenantId, id], onDelete: Restrict)
  items        LearningItem[]

  @@id([tenantId, id])
  @@unique([tenantId, id, courseSubjectId], map: "learning_units_tenant_id_id_course_subject_id_key")
  @@index([tenantId, courseSubjectId, status, sortOrder, id])
  @@map("learning_units")
}

model LearningItem {
  id                        String                       @default(uuid()) @db.Uuid
  tenantId                  String                       @map("tenant_id") @db.VarChar(128)
  courseSubjectId           String                       @map("course_subject_id") @db.Uuid
  learningUnitId            String                       @map("learning_unit_id") @db.Uuid
  type                      LearningItemType
  title                     String                       @db.VarChar(160)
  description               String?                      @db.Text
  content                   String?                      @db.Text
  instructions              String?                      @db.Text
  body                      String?                      @db.Text
  sortOrder                 Int                          @default(0) @map("sort_order")
  publicationStatus         LearningItemPublicationStatus @default(DRAFT) @map("publication_status")
  publishAt                 DateTime?                    @map("publish_at") @db.Timestamptz(3)
  publishedAt               DateTime?                    @map("published_at") @db.Timestamptz(3)
  publishedByIdentityUserId String?                      @map("published_by_identity_user_id") @db.VarChar(128)
  dueAt                     DateTime?                    @map("due_at") @db.Timestamptz(3)
  createdByIdentityUserId   String                       @map("created_by_identity_user_id") @db.VarChar(128)
  updatedByIdentityUserId   String?                      @map("updated_by_identity_user_id") @db.VarChar(128)
  createdAt                 DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  courseSubject CourseSubject @relation(fields: [tenantId, courseSubjectId], references: [tenantId, id], onDelete: Restrict)
  learningUnit LearningUnit @relation(fields: [tenantId, learningUnitId, courseSubjectId], references: [tenantId, id, courseSubjectId], onDelete: Restrict)

  @@id([tenantId, id])
  @@index([tenantId, courseSubjectId, publicationStatus, sortOrder, id])
  @@index([tenantId, learningUnitId, sortOrder, id])
  @@map("learning_items")
}
