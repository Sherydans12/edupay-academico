generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AcademicYearStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum CourseStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PersonStatus {
  ACTIVE
  INACTIVE
}

enum SubjectStatus {
  ACTIVE
  ARCHIVED
}

enum CourseSubjectStatus {
  ACTIVE
  ARCHIVED
}

enum RelationshipStatus {
  ACTIVE
  INACTIVE
}

enum LearningUnitStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum LearningItemType {
  MATERIAL
  ASSIGNMENT
  ASSESSMENT
  ANNOUNCEMENT
}

enum LearningItemPublicationStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum StorageScopeType {
  GLOBAL
  TENANT
}

enum StorageQuotaState {
  NORMAL
  INFO
  WARNING
  CRITICAL
  FULL
}

enum StorageCategory {
  LEARNING_MATERIAL
  ASSIGNMENT_SOURCE
  ASSESSMENT_SOURCE
  STUDENT_SUBMISSION
  GENERATED_DERIVATIVE
  OTHER_SYSTEM
}

enum StoredBlobLifecycle {
  PENDING
  VALIDATING
  AVAILABLE
  REJECTED
  DELETION_PENDING
}

enum StorageValidationStatus {
  NOT_VALIDATED
  VALID
  INVALID
}

enum StorageScanStatus {
  NOT_SCANNED
  PENDING
  CLEAR
  INFECTED
  FAILED
}

enum FileObjectLifecycle {
  PENDING
  AVAILABLE
  REJECTED
  DELETION_PENDING
}

enum FileReferenceType {
  LEARNING_ITEM
  SUBMISSION_REVISION
}

enum UploadIntentStatus {
  RESERVED
  STAGED
  FINALIZED
  FAILED
  EXPIRED
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  REVIEWED
  CHANGES_REQUESTED
}

enum ReviewAction {
  COMMENTED
  REVIEWED
  CHANGES_REQUESTED
}

enum NotificationEventType {
  ASSIGNMENT_PUBLISHED
  ASSESSMENT_PUBLISHED
  ANNOUNCEMENT_PUBLISHED
  SUBMISSION_RECEIVED
  RESUBMISSION_RECEIVED
  SUBMISSION_REVIEWED
  CHANGES_REQUESTED
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  RETRY
  FAILED
  SKIPPED
}

model Tenant {
  id        String   @id @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicYears             AcademicYear[]
  courses                   Course[]
  students                  Student[]
  teachers                  Teacher[]
  subjects                  Subject[]
  courseSubjects            CourseSubject[]
  courseEnrollments         CourseEnrollment[]
  studentSubjectEnrollments StudentSubjectEnrollment[]
  courseSubjectTeachers     CourseSubjectTeacher[]
  learningUnits             LearningUnit[]
  learningItems             LearningItem[]
  storageQuotaPolicies      StorageQuotaPolicy[]
  storageUsageAccounts      StorageUsageAccount[]
  storedBlobs                StoredBlob[]
  fileObjects                FileObject[]
  fileReferences             FileReference[]
  uploadIntents              UploadIntent[]
  submissions                Submission[]
  submissionRevisions        SubmissionRevision[]
  reviews                    Review[]
  notificationEvents         NotificationEvent[]
  notificationDeliveries     NotificationDelivery[]
  inAppNotifications         InAppNotification[]

  @@map("tenants")
}

model AcademicYear {
  id              String             @default(uuid()) @db.Uuid
  tenantId        String             @map("tenant_id") @db.VarChar(128)
  paginationToken String             @unique @default(uuid()) @map("pagination_token") @db.Uuid
  label           String             @db.VarChar(160)
  startDate       DateTime           @map("start_date") @db.Date
  endDate         DateTime           @map("end_date") @db.Date
  status          AcademicYearStatus @default(DRAFT)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  courses Course[]

  @@id([tenantId, id])
  @@unique([tenantId, label])
  @@index([tenantId, status, startDate])
  @@map("academic_years")
}

model Course {
  id              String       @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.VarChar(128)
  academicYearId  String       @map("academic_year_id") @db.Uuid
  paginationToken String       @unique @default(uuid()) @map("pagination_token") @db.Uuid
  label           String       @db.VarChar(160)
  status          CourseStatus @default(DRAFT)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear       @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict)
  courseSubjects CourseSubject[]
  enrollments    CourseEnrollment[]

  @@id([tenantId, id])
  @@unique([tenantId, academicYearId, label])
  @@index([tenantId, academicYearId, status, label])
  @@map("courses")
}

model Student {
  id                String       @default(uuid()) @db.Uuid
  tenantId          String       @map("tenant_id") @db.VarChar(128)
  paginationToken   String       @unique @default(uuid()) @map("pagination_token") @db.Uuid
  identityUserId    String?      @map("identity_user_id") @db.VarChar(128)
  source            String       @default("MANUAL") @db.VarChar(80)
  externalReference String?      @map("external_reference") @db.VarChar(200)
  firstName         String       @map("first_name") @db.VarChar(120)
  lastName          String       @map("last_name") @db.VarChar(120)
  email             String?      @db.VarChar(320)
  status            PersonStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  courseEnrollments  CourseEnrollment[]
  subjectEnrollments StudentSubjectEnrollment[]
  submissions         Submission[]

  @@id([tenantId, id])
  @@unique([tenantId, identityUserId])
  @@unique([tenantId, source, externalReference])
  @@index([tenantId, status, lastName, firstName])
  @@map("students")
}

model Teacher {
  id                String       @default(uuid()) @db.Uuid
  tenantId          String       @map("tenant_id") @db.VarChar(128)
  paginationToken   String       @unique @default(uuid()) @map("pagination_token") @db.Uuid
  identityUserId    String?      @map("identity_user_id") @db.VarChar(128)
  source            String       @default("MANUAL") @db.VarChar(80)
  externalReference String?      @map("external_reference") @db.VarChar(200)
  firstName         String       @map("first_name") @db.VarChar(120)
  lastName          String       @map("last_name") @db.VarChar(120)
  email             String?      @db.VarChar(320)
  status            PersonStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assignments CourseSubjectTeacher[]
  reviews     Review[]

  @@id([tenantId, id])
  @@unique([tenantId, identityUserId])
  @@unique([tenantId, source, externalReference])
  @@index([tenantId, status, lastName, firstName])
  @@map("teachers")
}

model Subject {
  id              String        @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.VarChar(128)
  paginationToken String        @unique @default(uuid()) @map("pagination_token") @db.Uuid
  name            String        @db.VarChar(160)
  status          SubjectStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  courseSubjects CourseSubject[]

  @@id([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId, status, name])
  @@map("subjects")
}

model CourseSubject {
  id               String              @default(uuid()) @db.Uuid
  tenantId         String              @map("tenant_id") @db.VarChar(128)
  courseId         String              @map("course_id") @db.Uuid
  subjectId        String              @map("subject_id") @db.Uuid
  paginationToken  String              @unique @default(uuid()) @map("pagination_token") @db.Uuid
  defaultForCourse Boolean             @default(true) @map("default_for_course")
  sortOrder        Int                 @default(0) @map("sort_order")
  status           CourseSubjectStatus @default(ACTIVE)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  course             Course                     @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Restrict)
  subject            Subject                    @relation(fields: [tenantId, subjectId], references: [tenantId, id], onDelete: Restrict)
  directEnrollments  StudentSubjectEnrollment[]
  teacherAssignments CourseSubjectTeacher[]
  learningUnits      LearningUnit[]
  learningItems      LearningItem[]

  @@id([tenantId, id])
  @@index([tenantId, courseId, status, sortOrder])
  @@index([tenantId, subjectId, status])
  @@map("course_subjects")
}

model CourseEnrollment {
  id        String             @default(uuid()) @db.Uuid
  tenantId  String             @map("tenant_id") @db.VarChar(128)
  studentId String             @map("student_id") @db.Uuid
  courseId  String             @map("course_id") @db.Uuid
  status    RelationshipStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)
  course  Course  @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, id])
  @@index([tenantId, courseId, status, studentId])
  @@index([tenantId, studentId, status, courseId])
  @@map("course_enrollments")
}

model StudentSubjectEnrollment {
  id              String             @default(uuid()) @db.Uuid
  tenantId        String             @map("tenant_id") @db.VarChar(128)
  studentId       String             @map("student_id") @db.Uuid
  courseSubjectId String             @map("course_subject_id") @db.Uuid
  status          RelationshipStatus @default(ACTIVE)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  student       Student       @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)
  courseSubject CourseSubject @relation(fields: [tenantId, courseSubjectId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, id])
  @@index([tenantId, studentId, status, courseSubjectId])
  @@index([tenantId, courseSubjectId, status, studentId])
  @@map("student_subject_enrollments")
}

model CourseSubjectTeacher {
  id              String             @default(uuid()) @db.Uuid
  tenantId        String             @map("tenant_id") @db.VarChar(128)
  teacherId       String             @map("teacher_id") @db.Uuid
  courseSubjectId String             @map("course_subject_id") @db.Uuid
  status          RelationshipStatus @default(ACTIVE)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  teacher       Teacher       @relation(fields: [tenantId, teacherId], references: [tenantId, id], onDelete: Restrict)
  courseSubject CourseSubject @relation(fields: [tenantId, courseSubjectId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, id])
  @@index([tenantId, teacherId, status, courseSubjectId])
  @@index([tenantId, courseSubjectId, status, teacherId])
  @@map("course_subject_teachers")
}

model LearningUnit {
  id              String            @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.VarChar(128)
  courseSubjectId String            @map("course_subject_id") @db.Uuid
  title           String            @db.VarChar(160)
  description     String?           @db.Text
  sortOrder       Int               @default(0) @map("sort_order")
  startAt         DateTime?         @map("start_at") @db.Timestamptz(3)
  endAt           DateTime?         @map("end_at") @db.Timestamptz(3)
  status          LearningUnitStatus @default(DRAFT)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  courseSubject CourseSubject @relation(fields: [tenantId, courseSubjectId], references: [tenantId, id], onDelete: Restrict)
  items        LearningItem[]

  @@id([tenantId, id])
  @@unique([tenantId, id, courseSubjectId], map: "learning_units_tenant_id_id_course_subject_id_key")
  @@index([tenantId, courseSubjectId, status, sortOrder, id])
  @@map("learning_units")
}

model LearningItem {
  id                        String                       @default(uuid()) @db.Uuid
  tenantId                  String                       @map("tenant_id") @db.VarChar(128)
  courseSubjectId           String                       @map("course_subject_id") @db.Uuid
  learningUnitId            String                       @map("learning_unit_id") @db.Uuid
  type                      LearningItemType
  title                     String                       @db.VarChar(160)
  description               String?                      @db.Text
  content                   String?                      @db.Text
  instructions              String?                      @db.Text
  body                      String?                      @db.Text
  sortOrder                 Int                          @default(0) @map("sort_order")
  publicationStatus         LearningItemPublicationStatus @default(DRAFT) @map("publication_status")
  publishAt                 DateTime?                    @map("publish_at") @db.Timestamptz(3)
  publishedAt               DateTime?                    @map("published_at") @db.Timestamptz(3)
  publishedByIdentityUserId String?                      @map("published_by_identity_user_id") @db.VarChar(128)
  dueAt                     DateTime?                    @map("due_at") @db.Timestamptz(3)
  createdByIdentityUserId   String                       @map("created_by_identity_user_id") @db.VarChar(128)
  updatedByIdentityUserId   String?                      @map("updated_by_identity_user_id") @db.VarChar(128)
  createdAt                 DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  courseSubject CourseSubject @relation(fields: [tenantId, courseSubjectId], references: [tenantId, id], onDelete: Restrict)
  learningUnit LearningUnit @relation(fields: [tenantId, learningUnitId, courseSubjectId], references: [tenantId, id, courseSubjectId], onDelete: Restrict)
  fileReferences FileReference[]
  submissions    Submission[]

  @@id([tenantId, id])
  @@index([tenantId, courseSubjectId, publicationStatus, sortOrder, id])
  @@index([tenantId, learningUnitId, sortOrder, id])
  @@map("learning_items")
}

model StorageQuotaPolicy {
  id                       String           @id @default(uuid()) @db.Uuid
  scopeKey                 String           @unique @map("scope_key") @db.VarChar(160)
  scopeType                StorageScopeType @map("scope_type")
  tenantId                 String?          @map("tenant_id") @db.VarChar(128)
  quotaBytes               BigInt           @map("quota_bytes")
  infoThresholdPercent     Float            @default(75) @map("info_threshold_percent")
  warningThresholdPercent  Float            @default(90) @map("warning_threshold_percent")
  criticalThresholdPercent Float            @default(95) @map("critical_threshold_percent")
  version                  Int              @default(1)
  effectiveAt              DateTime         @default(now()) @map("effective_at") @db.Timestamptz(3)
  changedByIdentityUserId  String?          @map("changed_by_identity_user_id") @db.VarChar(128)
  auditReason              String?          @map("audit_reason") @db.VarChar(500)
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([scopeType, tenantId])
  @@index([tenantId, scopeType])
  @@map("storage_quota_policies")
}

model StorageUsageAccount {
  id               String           @id @default(uuid()) @db.Uuid
  scopeKey         String           @unique @map("scope_key") @db.VarChar(160)
  scopeType        StorageScopeType @map("scope_type")
  tenantId         String?          @map("tenant_id") @db.VarChar(128)
  usedBytes        BigInt           @default(0) @map("used_bytes")
  reservedBytes    BigInt           @default(0) @map("reserved_bytes")
  fileCount        Int              @default(0) @map("file_count")
  blobCount        Int              @default(0) @map("blob_count")
  version          Int              @default(1)
  lastReconciledAt DateTime?        @map("last_reconciled_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([scopeType, tenantId])
  @@index([tenantId, scopeType])
  @@map("storage_usage_accounts")
}

model StoredBlob {
  id                String                  @default(uuid()) @db.Uuid
  tenantId          String                  @map("tenant_id") @db.VarChar(128)
  storageKey        String                  @unique @map("storage_key") @db.VarChar(500)
  sha256            String                  @db.Char(64)
  storedSizeBytes   BigInt                  @map("stored_size_bytes")
  detectedMime      String                  @map("detected_mime") @db.VarChar(160)
  detectedExtension String                  @map("detected_extension") @db.VarChar(16)
  lifecycle         StoredBlobLifecycle     @default(PENDING)
  validationStatus  StorageValidationStatus @default(NOT_VALIDATED) @map("validation_status")
  scanStatus        StorageScanStatus      @default(NOT_SCANNED) @map("scan_status")
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  validatedAt       DateTime?               @map("validated_at") @db.Timestamptz(3)
  availableAt       DateTime?               @map("available_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  fileObjects FileObject[]
  sourceDerivatives BlobDerivative[] @relation("source_blob")
  derivativeOf BlobDerivative[] @relation("derivative_blob")

  @@id([tenantId, id])
  @@unique([tenantId, sha256, storedSizeBytes])
  @@index([tenantId, lifecycle])
  @@map("stored_blobs")
}

model FileObject {
  id                       String              @default(uuid()) @db.Uuid
  tenantId                 String              @map("tenant_id") @db.VarChar(128)
  storedBlobId             String              @map("stored_blob_id") @db.Uuid
  originalFilename         String              @map("original_filename") @db.VarChar(255)
  normalizedFilename       String              @map("normalized_filename") @db.VarChar(255)
  declaredSizeBytes        BigInt              @map("declared_size_bytes")
  authoritativeSizeBytes   BigInt              @map("authoritative_size_bytes")
  declaredMime             String              @map("declared_mime") @db.VarChar(160)
  detectedMime             String              @map("detected_mime") @db.VarChar(160)
  extension                String              @db.VarChar(16)
  category                 StorageCategory
  uploadedByIdentityUserId String              @map("uploaded_by_identity_user_id") @db.VarChar(128)
  isImmutableEvidence      Boolean             @default(true) @map("is_immutable_evidence")
  lifecycle                FileObjectLifecycle @default(AVAILABLE)
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  validatedAt              DateTime?           @map("validated_at") @db.Timestamptz(3)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  storedBlob     StoredBlob      @relation(fields: [tenantId, storedBlobId], references: [tenantId, id], onDelete: Restrict)
  fileReferences FileReference[]

  @@id([tenantId, id])
  @@index([tenantId, category, lifecycle])
  @@index([tenantId, storedBlobId])
  @@map("file_objects")
}

model FileReference {
  id                       String              @default(uuid()) @db.Uuid
  tenantId                 String              @map("tenant_id") @db.VarChar(128)
  fileObjectId             String              @map("file_object_id") @db.Uuid
  referenceType            FileReferenceType   @map("reference_type")
  category                 StorageCategory
  learningItemId           String?             @map("learning_item_id") @db.Uuid
  submissionRevisionId     String?             @map("submission_revision_id") @db.Uuid
  displayOrder             Int                 @default(0) @map("display_order")
  createdByIdentityUserId  String              @map("created_by_identity_user_id") @db.VarChar(128)
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  fileObject         FileObject          @relation(fields: [tenantId, fileObjectId], references: [tenantId, id], onDelete: Restrict)
  learningItem       LearningItem?       @relation(fields: [tenantId, learningItemId], references: [tenantId, id], onDelete: Restrict)
  submissionRevision SubmissionRevision? @relation(fields: [tenantId, submissionRevisionId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, id])
  @@index([tenantId, fileObjectId])
  @@index([tenantId, learningItemId])
  @@index([tenantId, submissionRevisionId])
  @@map("file_references")
}

model UploadIntent {
  id                       String             @default(uuid()) @db.Uuid
  tenantId                 String             @map("tenant_id") @db.VarChar(128)
  createdByIdentityUserId  String             @map("created_by_identity_user_id") @db.VarChar(128)
  parentType               FileReferenceType  @map("parent_type")
  parentId                 String             @map("parent_id") @db.Uuid
  category                 StorageCategory
  expectedFilename         String             @map("expected_filename") @db.VarChar(255)
  expectedSizeBytes        BigInt             @map("expected_size_bytes")
  expectedMime             String             @map("expected_mime") @db.VarChar(160)
  reservedBytes            BigInt             @map("reserved_bytes")
  stagingKey               String             @unique @map("staging_key") @db.VarChar(500)
  status                   UploadIntentStatus @default(RESERVED)
  expiresAt                DateTime           @map("expires_at") @db.Timestamptz(3)
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  finalizedAt              DateTime?          @map("finalized_at") @db.Timestamptz(3)
  finalizedFileObjectId    String?            @map("finalized_file_object_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, id])
  @@index([tenantId, status, expiresAt])
  @@index([tenantId, finalizedFileObjectId])
  @@map("upload_intents")
}

model Submission {
  id             String           @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.VarChar(128)
  studentId      String           @map("student_id") @db.Uuid
  learningItemId String           @map("learning_item_id") @db.Uuid
  status         SubmissionStatus @default(PENDING)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  student      Student             @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)
  learningItem LearningItem         @relation(fields: [tenantId, learningItemId], references: [tenantId, id], onDelete: Restrict)
  revisions    SubmissionRevision[]

  @@id([tenantId, id])
  @@unique([tenantId, studentId, learningItemId])
  @@index([tenantId, learningItemId, status, updatedAt])
  @@index([tenantId, studentId, updatedAt])
  @@map("submissions")
}

model SubmissionRevision {
  id                       String   @default(uuid()) @db.Uuid
  tenantId                 String   @map("tenant_id") @db.VarChar(128)
  submissionId             String   @map("submission_id") @db.Uuid
  revisionNumber           Int      @map("revision_number")
  studentComment           String?  @map("student_comment") @db.Text
  submittedAt              DateTime @map("submitted_at") @db.Timestamptz(3)
  effectiveDueAt           DateTime @map("effective_due_at") @db.Timestamptz(3)
  isLate                   Boolean  @map("is_late")
  createdByIdentityUserId  String   @map("created_by_identity_user_id") @db.VarChar(128)
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  submission     Submission          @relation(fields: [tenantId, submissionId], references: [tenantId, id], onDelete: Restrict)
  fileReferences FileReference[]
  reviews        Review[]

  @@id([tenantId, id])
  @@unique([tenantId, submissionId, revisionNumber])
  @@index([tenantId, submissionId, revisionNumber])
  @@map("submission_revisions")
}

model Review {
  id                       String       @default(uuid()) @db.Uuid
  tenantId                 String       @map("tenant_id") @db.VarChar(128)
  submissionRevisionId     String       @map("submission_revision_id") @db.Uuid
  reviewerTeacherId        String?      @map("reviewer_teacher_id") @db.Uuid
  reviewerIdentityUserId   String       @map("reviewer_identity_user_id") @db.VarChar(128)
  action                   ReviewAction
  comment                  String?      @db.Text
  createdAt                DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  submissionRevision SubmissionRevision @relation(fields: [tenantId, submissionRevisionId], references: [tenantId, id], onDelete: Restrict)
  reviewerTeacher    Teacher?           @relation(fields: [tenantId, reviewerTeacherId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, id])
  @@index([tenantId, submissionRevisionId, createdAt])
  @@map("reviews")
}

model NotificationEvent {
  id            String               @db.VarChar(220)
  tenantId      String               @map("tenant_id") @db.VarChar(128)
  eventType     NotificationEventType @map("event_type")
  aggregateType String               @map("aggregate_type") @db.VarChar(80)
  aggregateId   String               @map("aggregate_id") @db.VarChar(128)
  payload       Json                 @db.JsonB
  occurredAt    DateTime             @map("occurred_at") @db.Timestamptz(3)
  notBefore     DateTime             @map("not_before") @db.Timestamptz(3)
  requestId     String?              @map("request_id") @db.VarChar(128)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  deliveries NotificationDelivery[]

  @@id([tenantId, id])
  @@index([tenantId, eventType, notBefore])
  @@index([tenantId, aggregateType, aggregateId])
  @@map("notification_events")
}

model NotificationDelivery {
  id                      String                    @db.Uuid
  tenantId                String                    @map("tenant_id") @db.VarChar(128)
  eventId                 String                    @map("event_id") @db.VarChar(220)
  recipientKey            String                    @map("recipient_key") @db.VarChar(220)
  recipientIdentityUserId String?                   @map("recipient_identity_user_id") @db.VarChar(128)
  recipientEmail          String?                   @map("recipient_email") @db.VarChar(320)
  channel                 NotificationChannel
  templateVersion         String                    @map("template_version") @db.VarChar(40)
  idempotencyKey          String                    @unique @map("idempotency_key") @db.VarChar(500)
  status                  NotificationDeliveryStatus @default(PENDING)
  attemptCount            Int                       @default(0) @map("attempt_count")
  nextAttemptAt           DateTime                  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedAt                DateTime?                 @map("locked_at") @db.Timestamptz(3)
  lastAttemptAt           DateTime?                 @map("last_attempt_at") @db.Timestamptz(3)
  sentAt                  DateTime?                 @map("sent_at") @db.Timestamptz(3)
  providerMessageId       String?                   @map("provider_message_id") @db.VarChar(200)
  lastErrorCategory       String?                   @map("last_error_category") @db.VarChar(80)
  lastErrorMessage        String?                   @map("last_error_message") @db.VarChar(500)
  skipReason              String?                   @map("skip_reason") @db.VarChar(120)
  createdAt               DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  event       NotificationEvent  @relation(fields: [tenantId, eventId], references: [tenantId, id], onDelete: Restrict)
  inApp       InAppNotification?

  @@id([tenantId, id])
  @@unique([tenantId, eventId, recipientKey, channel, templateVersion])
  @@index([tenantId, status, nextAttemptAt, id])
  @@index([tenantId, recipientIdentityUserId, channel, status])
  @@map("notification_deliveries")
}

model InAppNotification {
  id                   String   @db.Uuid
  tenantId             String   @map("tenant_id") @db.VarChar(128)
  notificationDeliveryId String @map("notification_delivery_id") @db.Uuid
  recipientIdentityUserId String @map("recipient_identity_user_id") @db.VarChar(128)
  type                 NotificationEventType
  title                String   @db.VarChar(200)
  body                 String   @db.VarChar(500)
  targetPath           String   @map("target_path") @db.VarChar(500)
  eventId              String   @map("event_id") @db.VarChar(220)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt               DateTime? @map("read_at") @db.Timestamptz(3)

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  delivery NotificationDelivery @relation(fields: [tenantId, notificationDeliveryId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, id])
  @@unique([tenantId, notificationDeliveryId])
  @@index([tenantId, recipientIdentityUserId, createdAt, id])
  @@index([tenantId, recipientIdentityUserId, readAt])
  @@map("in_app_notifications")
}

model BlobDerivative {
  id               String   @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.VarChar(128)
  sourceBlobId     String   @map("source_blob_id") @db.Uuid
  derivativeBlobId String   @map("derivative_blob_id") @db.Uuid
  profile          String   @db.VarChar(120)
  profileVersion   String   @map("profile_version") @db.VarChar(40)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sourceBlob     StoredBlob @relation("source_blob", fields: [tenantId, sourceBlobId], references: [tenantId, id], onDelete: Restrict)
  derivativeBlob StoredBlob @relation("derivative_blob", fields: [tenantId, derivativeBlobId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, id])
  @@unique([tenantId, sourceBlobId, profile, profileVersion])
  @@index([tenantId, derivativeBlobId])
  @@map("blob_derivatives")
}
