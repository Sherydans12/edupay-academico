NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001

# Synthetic local example only. Never commit real database credentials.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/edupay_academico?schema=public

# EduPay Identity consumer configuration. Académico stores no Identity secrets.
IDENTITY_ISSUER=http://localhost:3000
IDENTITY_AUDIENCE=edupay-academico-api
IDENTITY_JWKS_URI=http://localhost:3000/.well-known/jwks.json
# Comma-separated asymmetric allowlist. Symmetric and unsigned JWTs are rejected.
IDENTITY_JWT_ALGORITHMS=RS256
IDENTITY_CLOCK_SKEW_SECONDS=30
IDENTITY_JWKS_CACHE_MAX_AGE_MS=300000
IDENTITY_JWKS_COOLDOWN_MS=30000
IDENTITY_JWKS_TIMEOUT_MS=5000

# Restricted server-to-server Identity verification. Never use NEXT_PUBLIC_*.
# Prefer a private trusted network address; otherwise use HTTPS.
IDENTITY_INTERNAL_BASE_URL=http://localhost:3000
# Generate at least 32 random bytes and encode them as base64url.
IDENTITY_INTERNAL_SERVICE_TOKEN=
IDENTITY_INTERNAL_TIMEOUT_MS=3000

# Dedicated read-only EduPay roster integration. Token is server-only and is
# never stored in PostgreSQL or exposed through NEXT_PUBLIC_* configuration.
EDUPAY_INTEGRATION_BASE_URL=http://localhost:3002
EDUPAY_INTEGRATION_TOKEN=
EDUPAY_INTEGRATION_TIMEOUT_MS=5000
EDUPAY_INTEGRATION_ALLOW_PRIVATE_HTTP=false
EDUPAY_SYNC_PAGE_SIZE=100
EDUPAY_SYNC_WORKER_POLL_INTERVAL_MS=60000
EDUPAY_SYNC_INCREMENTAL_INTERVAL_MINUTES=60
EDUPAY_SYNC_FULL_HOUR_UTC=2
EDUPAY_SYNC_MAX_RUN_ATTEMPTS=3
EDUPAY_SYNC_RETRY_SCHEDULE_SECONDS=60,300,900,3600,21600
EDUPAY_SYNC_LEASE_SECONDS=900
EDUPAY_SYNC_ITEM_EVIDENCE_LIMIT=500
EDUPAY_SYNC_EVIDENCE_RETENTION_DAYS=30

# Academic Financial Projection v1. Both flags are false by default: this
# branch creates no external traffic until an operator configures tenant-bound
# S2S credentials and activates it deliberately.
ACADEMIC_FINANCIAL_PROJECTION_ENABLED=false
ACADEMIC_FINANCIAL_PROJECTION_S2S_CREDENTIALS='[{"keyId":"bl-shadow-2026-01","token":"CHANGE_ME_32_plus_character_random_service_secret","canonicalTenantId":"11111111-1111-4111-8111-111111111111"}]'
ACADEMIC_FINANCIAL_PROJECTION_CURSOR_SECRET=CHANGE_ME_32_plus_character_random_cursor_secret
ACADEMIC_FINANCIAL_PROJECTION_SNAPSHOT_TTL_SECONDS=3600
ACADEMIC_FINANCIAL_PROJECTION_PUBLISHER_ENABLED=false
BL_FINANCIAL_PROJECTION_BASE_URL=http://localhost:3002
BL_FINANCIAL_PROJECTION_SERVICE_KEY_ID=academic-producer-2026-01
BL_FINANCIAL_PROJECTION_SERVICE_TOKEN=CHANGE_ME_32_plus_character_random_service_secret
BL_FINANCIAL_PROJECTION_TIMEOUT_MS=5000
BL_FINANCIAL_PROJECTION_MAX_ATTEMPTS=5
BL_FINANCIAL_PROJECTION_RETRY_SCHEDULE_SECONDS=60,300,900,3600,21600

# Exact browser origin allowlist for Academic API CORS. No wildcard origins.
ACADEMIC_TRUSTED_WEB_ORIGINS=http://localhost:3000

# Private local storage adapter. Both physical safety values are required in production.
STORAGE_ROOT=./var/private-storage
STORAGE_TEMP_ROOT=./var/private-storage/tmp
STORAGE_MIN_FREE_BYTES=
STORAGE_MIN_FREE_PERCENTAGE=

# Malware scanning. Set fake only for development/test; production requires
# ClamAV and never accepts unscanned uploads.
ACADEMIC_MALWARE_SCANNER=fake
ACADEMIC_CLAMAV_HOST=
ACADEMIC_CLAMAV_PORT=3310
ACADEMIC_CLAMAV_TIMEOUT_MS=10000
ACADEMIC_MALWARE_SCAN_CONCURRENCY=2

# RFC Course Builder Phase 5 rollback seam. Set false to keep serving the
# additive scalar fields while retaining body_document data for re-enable.
ACADEMIC_BODY_DOCUMENT_READ_ENABLED=true

# Académico-only operational email delivery. Never reuse EduPay Identity secrets.
ACADEMIC_RESEND_API_KEY=
ACADEMIC_EMAIL_FROM=EduPay Académico <no-reply@example.invalid>
ACADEMIC_PUBLIC_BASE_URL=http://localhost:3001
ACADEMIC_EMAIL_REPLY_TO=
ACADEMIC_EMAIL_MODE=resend

# PostgreSQL notification worker defaults.
NOTIFICATION_WORKER_POLL_INTERVAL_MS=5000
NOTIFICATION_WORKER_BATCH_SIZE=50
NOTIFICATION_MAX_DELIVERY_ATTEMPTS=5
NOTIFICATION_PROCESSING_LEASE_SECONDS=900
NOTIFICATION_RETRY_SCHEDULE_SECONDS=60,300,900,3600,21600
